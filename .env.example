# Vendor keys. Copy to ~/.config/quotarouter/.env (or ./.env next to your project, or point
# QUOTAROUTER_ENV_FILE at any file with this shape) and fill in what you have.
#
# Every vendor is optional: a stage without a key is skipped, never dialed. With no keys at all
# the router still answers through the anonymous tier (see "Last resort" in the README).
#
# Never commit the filled-in copy. Nothing here is read unless the matching stage is enabled.

# Search (free tier), also used as an extract fallback
EXA_API_KEY=

# Search and extract (free monthly credits; the only vendor that reports an exact balance)
FIRECRAWL_API_KEY=

# Search and extract (paid balance; the stage parks itself while the balance is empty and
# returns on its own after a top-up)
DEEPSEEK_API_KEY=

# Search (optional; free plan is 1000 credits a month)
TAVILY_API_KEY=

# Search (optional; first in the default chain once a key is present)
KEENABLE_API_KEY=

# The Reader works without a key; a key only raises the rate limit
JINA_API_KEY=

# --- router knobs, all optional -----------------------------------------------------------
# QUOTAROUTER_SEARCH_ORDER=exa,firecrawl,deepseek
# QUOTAROUTER_EXTRACT_ORDER=jina,firecrawl,exa
# QUOTAROUTER_STATE_DIR=~/.local/state/quotarouter
# QUOTAROUTER_ALLOW_KEYLESS=1
# QUOTAROUTER_QUOTA_RETRY=900
